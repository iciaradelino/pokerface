{
  "name": "@pokerface/players",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "format": "prettier --write \"{src,test}/**/*.js\" *.config.js",
    "format:check": "prettier --check \"{src,test}/**/*.js\" *.config.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "mssql": "12.7.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "vitest": "3.2.7"
  }
}
